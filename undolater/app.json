{
  "expo": {
    "name": "UndoLater",
    "slug": "undolater",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F8F7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.undolater.app"
    },
    "android": {
      "package": "com.undolater.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#171718"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A1A19",
          "sounds": [
            "./assets/sounds/undo_chime.wav"
          ],
          "defaultChannel": "reminders-chime"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UndoLater uses your photos so you can attach a 'before' picture of what you changed.",
          "cameraPermission": "UndoLater uses the camera so you can snap a 'before' picture of what you changed.",
          "microphonePermission": false
        }
      ],
      "expo-router"
    ],
    "scheme": "undolater"
  }
}
