; Engine configuration file.
config_version=5

[application]

config/name="Jazira - Tiny Island"
config/description="A tiny, physically simulated sandbox island. Dig, chop, build."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
config/version="0.4"
boot_splash/bg_color=Color(0.02, 0.04, 0.06, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

Settings="*res://scripts/core/settings.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
textures/default_filters/anisotropic_filtering_level=3
