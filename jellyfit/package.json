{
  "name": "jellyfit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src sim tests scripts",
    "zip": "node scripts/zip.mjs",
    "single": "node scripts/singlefile.mjs",
    "shots": "node scripts/shots.mjs",
    "sim": "tsx sim/simulate.ts",
    "smoke": "node scripts/smoke.mjs",
    "apk": "npm run build && npx cap sync android && python3 scripts/android_setup.py && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@fontsource/baloo-bhaijaan-2": "^5.2.5"
  }
}
